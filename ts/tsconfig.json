{
    "compilerOptions": {
      "target": "es2016",
      "module": "commonjs",
      "moduleResolution": "node",
      "declaration": true,
      "outDir": "./dist",
      "esModuleInterop": true,
      "strict": false,
      "skipDefaultLibCheck": true,
      "skipLibCheck": true,
    },
    "include": [
      "./src/**/*",
      "./src/types/*",
    ],
    "exclude": [
      "./tests/**/*"
    ]
  }
  